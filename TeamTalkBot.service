[Unit]
Description=TeamTalk Bot Service
After=network.target

[Service]
ExecStart=/root/TeamTalkBot/main.sh
WorkingDirectory=/root/TeamTalkBot
Restart=always
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/root/TeamTalkBot/teamtalk.log
StandardError=append:/root/TeamTalkBot/teamtalk.err

[Install]
WantedBy=multi-user.target
