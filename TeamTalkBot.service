# Template: replace "teamtalk" with the (non-root) account that owns the
# checkout, then install it as /etc/systemd/system/TeamTalkBot.service.
# Logs go to the journal: journalctl -u TeamTalkBot -f
[Unit]
Description=TeamTalk Bot Service
After=network-online.target
Wants=network-online.target

[Service]
User=teamtalk
Group=teamtalk
WorkingDirectory=/home/teamtalk/TeamTalkBot
ExecStart=/home/teamtalk/TeamTalkBot/main.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
